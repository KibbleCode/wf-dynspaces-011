build libdynspaces011.so.p/libdynspaces011.so.symbols: SHSYM libdynspaces011.so
 IMPLIB = libdynspaces011.so

build libdynspaces011.so: cpp_LINKER libdynspaces011.so.p/dynspaces011.cpp.o | /usr/lib/libGLESv2.so /usr/lib/libcairo.so /usr/lib/libglib-2.0.so /usr/lib/libgobject-2.0.so /usr/lib/libharfbuzz.so /usr/lib/libm.a /usr/lib/libm.so /usr/lib/libpango-1.0.so /usr/lib/libpangocairo-1.0.so /usr/lib/libpixman-1.so /usr/lib/libwayland-server.so /usr/lib/libwf-config.so /usr/lib/libwlroots-0.20.so
